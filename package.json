{
	"name": "n8n-nodes-cavuno",
	"version": "0.2.1",
	"description": "n8n community node for Cavuno job boards — jobs, companies, candidates, marketing permissions, and signed webhook triggers",
	"license": "MIT",
	"homepage": "https://cavuno.com",
	"keywords": [
		"n8n-community-node-package",
		"cavuno",
		"job-board",
		"jobs",
		"webhooks"
	],
	"author": {
		"name": "Cavuno",
		"email": "hi@cavuno.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/wollemiahq/n8n-nodes-cavuno.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test test/*.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CavunoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Cavuno/Cavuno.node.js",
			"dist/nodes/CavunoTrigger/CavunoTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.44.3",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
